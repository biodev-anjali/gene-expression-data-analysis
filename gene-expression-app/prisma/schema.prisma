// Migrated from SQLite to PostgreSQL for Vercel serverless compatibility
// SQLite is not supported in serverless environments (no file system access)
// PostgreSQL is provided via Neon/Supabase and configured via DATABASE_URL env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GeneExpressionRun {
  id                String   @id @default(uuid())
  fileName          String?
  fileHash          String   @unique
  genes             Int
  samples           Int
  meanExpr          Float?
  upregulatedGenes  Int?
  downregulatedGenes Int?
  foldChangeData    String?  // JSON string storing fold change analysis
  createdAt         DateTime @default(now())
}
